# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used only by /api/submit and /api/upload-url
# to create tickets and signed upload URLs for the public form.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: require Laguna College emails to end with this domain. Leave empty to accept any valid email.
NEXT_PUBLIC_LC_EMAIL_DOMAIN=lagunacollege.edu.ph
